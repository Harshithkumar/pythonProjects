pipeline {
    agent any

    stages {
        stage('Preparation') {
            steps {
                git branch: 'origin-master', credentialsId: '04188909-850a-441c-bd05-8a6f202191da', poll: false, url: 'https://github.com/Harshithkumar/pythonProjects'
            }
        }
        
         stage('SetUp') {
            steps {
                dir('appium_experiments'){
                    sh 'pip3 install -r requirements.txt'
                    
                } 
            }
        }
        
        stage('Execution') {
        steps{
             dir('appium_experiments') {
                 sh 'python3 pureCompose.py'
                }
            }
        }
    }
    post {
            always {
                script {
                   allure includeProperties: false, jdk: '', results: [[path: 'appium_experiments/allure-results']]
                }
            }
    }
}
